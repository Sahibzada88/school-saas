# ---- Core ----
SECRET_KEY=                       # production: >= 50 random chars (python -c "import secrets;print(secrets.token_urlsafe(64))")
DEBUG=False
ENVIRONMENT=local                 # local | production
DJANGO_SETTINGS_MODULE=config.settings.local   # production: config.settings.production
LOG_LEVEL=INFO

# ---- Database (Supabase) ----
# Runtime: TRANSACTION pooler (port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Migrations only: SESSION pooler (port 5432). Use with DJANGO_USE_DIRECT_URL=1
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DB_SSLMODE=require              # optional alternative to ?sslmode= in the URL
# ENABLE_RLS_LOCKDOWN=True        # post-migrate: enable RLS + revoke anon/authenticated on every public table

# ---- Hosts / origins ----
ALLOWED_HOSTS=localhost,127.0.0.1                 # production: backend hostname(s)
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000        # allowed values of the Origin header on unsafe requests
FRONTEND_ORIGIN=http://localhost:3000             # also used to build password-reset links

# ---- Client IP behind the Next.js proxy ----
# Same random value in the frontend project (PROXY_SHARED_SECRET). The backend only trusts the
# X-Client-IP header when X-Proxy-Secret matches. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
PROXY_SHARED_SECRET=
# TRUSTED_IP_HEADER=              # optional Django META key (e.g. HTTP_X_FORWARDED_FOR) for non-proxied deployments

# ---- Auth ----
JWT_SIGNING_KEY=                  # optional; falls back to SECRET_KEY. Use a separate random value in production.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_DOMAIN=                    # leave empty: host-only cookies on the frontend origin
COOKIE_SAMESITE=Lax
COOKIE_SECURE=False               # local http. Production forces True.
PASSWORD_RESET_TOKEN_MINUTES=30

# ---- Email (optional; console prints to the terminal in local dev) ----
EMAIL_BACKEND=console             # console | smtp
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=

# ---- Optional ----
TURNSTILE_SECRET_KEY=
